    MC_RX --> FEC_REC
    FEC_REC -->|"Recovered source"| MoQ_PUB
    CONV -->|"JSON catalog"| MoQ_PUB
    MoQ_PUB -->|"QUIC"| SUB1
    MoQ_PUB -->|"QUIC"| SUB2
    MoQ_PUB -->|"QUIC"| SUB3
