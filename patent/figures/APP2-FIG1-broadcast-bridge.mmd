graph LR
    subgraph Broadcast["Broadcast (101)"]
        TX["ATSC 3.0 / ARIB<br/>Transmitter"]
        STSID["S-TSID<br/>Signaling (102)"]
    end

    subgraph Gateway["Bridge Gateway (103)"]
        MC_RX["Step 103a<br/>Multicast Rx<br/>SSM Join"]
